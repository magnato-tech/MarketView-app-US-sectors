OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1

# Gemini (AI-markedsrapport og chat). Opprett nøkkel i Google AI Studio — ikke del den offentlig.
# VITE_* eksponeres til nettleseren; for produksjon vurder proxy/backend i stedet.
# VITE_GEMINI_API_KEY=
# GEMINI_API_KEY=

# Supabase (factory persistence). Anbefalt for Vite:
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   (anon / public key fra Project API keys)
# Støttes også: SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL, SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY
