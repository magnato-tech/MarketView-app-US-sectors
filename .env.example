OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1

# Gemini (AI-markedsrapport og chat). Opprett nøkkel i Google AI Studio — ikke del den offentlig.
# VITE_* eksponeres til nettleseren; for produksjon vurder proxy/backend i stedet.
# VITE_GEMINI_API_KEY=
# GEMINI_API_KEY=

# Supabase (factory persistence). Anbefalt for Vite:
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   (anon / public key fra Project API keys)
# Støttes også: SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL, SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY

# Crisis Monitor (Python: kinvest_monitor.py)
# SUPABASE_URL=https://xxxx.supabase.co   (eller bruk VITE_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...       (kun backend/Python — aldri VITE_)
# TWELVE_DATA_API_KEY=   (alias: TWELVE_DATA_KEY)
# ALPHA_VANTAGE_API_KEY= (alias: ALPHA_VANTAGE_KEY)
# HELIUM_PLACEHOLDER_CSV=helium_placeholder.csv
# KINVEST_BLOCKADE_START=2026-03-15
